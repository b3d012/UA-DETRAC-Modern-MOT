# Python
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.env

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# UA-DETRAC raw data: NEVER commit dataset archives, frames, or annotations
# Recommended local checkout location:
/data/ua_detrac/
/data/raw/
/data/external/
/data/UA-DETRAC/
/data/DETRAC-*/
*.zip
*.tar
*.tar.gz
*.7z

# Large model/data artifacts
*.pt
*.pth
*.onnx
*.engine
*.ckpt
*.weights

# Experiment outputs (keep directory placeholders only)
outputs/detections/*
!outputs/detections/.gitkeep
outputs/tracks/*
!outputs/tracks/.gitkeep
outputs/metrics/*
!outputs/metrics/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep

# Runtime-generated manifests/splits may be committed only after review
# Keep generated temporary files ignored by default.
data/manifests/*.tmp
data/splits/*.tmp

# Logs / caches
*.log
.cache/
wandb/
runs/
